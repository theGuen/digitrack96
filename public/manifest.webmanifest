{
  "name": "Digitrack 96",
  "short_name": "Digitrack 96",
  "description": "A small four-track wave editor in the spirit of the pre-DAW era.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#008080",
  "theme_color": "#c0c0c0",
  "launch_handler": { "client_mode": "focus-existing" },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "audio/wav": [".wav"],
        "audio/x-wav": [".wav"],
        "audio/mpeg": [".mp3"],
        "application/octet-stream": [".smp"]
      }
    }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
